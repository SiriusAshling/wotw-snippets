#category("Gameplay")
#name("Clear World")
#description("Allows clearing the world after finishing the game")

!state(enabled, Boolean)

on gameStateGroup.gameFinished store(enabled, true)

on reload {
    set_wheel_item_name("root", TopRight, "Clear finished World")
    set_wheel_item_icon("root", TopRight, Pierce)
}

on reload update_wheel()
on change enabled update_wheel()
fun update_wheel() {
    if enabled {
        set_wheel_item_description("root", TopRight, "[Ability1]Clear World\n[Ability2]Disable")
        set_wheel_item_color("root", TopRight, 255, 255, 255, 255)
        set_wheel_item_action("root", TopRight, Ability1, clear_world())
        set_wheel_item_action("root", TopRight, Ability2, store(enabled, false))
        set_wheel_item_action("root", TopRight, Ability3, store(enabled, false))
    }
    if enabled == false {
        set_wheel_item_color("root", TopRight, 128, 128, 128, 196)
        if gameStateGroup.gameFinished {
            set_wheel_item_description("root", TopRight, "Disabled\n[Ability1]Enable")
            set_wheel_item_all_actions("root", TopRight, store(enabled, true))
        }
        if gameStateGroup.gameFinished == false {
            set_wheel_item_description("root", TopRight, "Locked\n[Ability3]Force enable")
            set_wheel_item_action("root", TopRight, Ability1, {})
            set_wheel_item_action("root", TopRight, Ability2, {})
            set_wheel_item_action("root", TopRight, Ability3, store(enabled, true))
        }
    }
}

on enabled priority_message("Clear World enabled\nYou can #clear remaining items# in the [OpenRandomizerWheel]Rando Wheel")
on enabled == false priority_message("Clear World disabled")

