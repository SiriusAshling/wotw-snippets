#category("Gameplay")
#name("Vision")
#description("Ori learns to use his eyes")

!config_integer(radius, 22, "Radius", "How far you can see")

!item_on(marsh_spawn_rock_hf, Marsh.Spawn.LeftLF)
on spawn if Marsh.Spawn.LeftLF == false {
    free_message_uninitialized("Marsh.Spawn.LeftLF")
    set_message_text("Marsh.Spawn.LeftLF", marsh_spawn_rock_hf)
    set_message_coordinate_system("Marsh.Spawn.LeftLF", World)
    set_message_vertical_anchor("Marsh.Spawn.LeftLF", Middle)
    set_message_position("Marsh.Spawn.LeftLF", -958.6, -4313.2)
}
on reload {
    position_trigger_circle("Marsh.Spawn.LeftLF", -958.6, -4313.2, radius)
    position_trigger_enter_callback("Marsh.Spawn.LeftLF", free_message_show("Marsh.Spawn.LeftLF", true, false))
    position_trigger_leave_callback("Marsh.Spawn.LeftLF", free_message_hide("Marsh.Spawn.LeftLF", true))
}
on Marsh.Spawn.LeftLF {
    destroy_message("Marsh.Spawn.LeftLF")
    position_trigger_destroy("Marsh.Spawn.LeftLF")
}

