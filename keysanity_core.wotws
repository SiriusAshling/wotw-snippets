!export(regenerate_tree_keystone_a)
fun regenerate_tree_keystone_a() {
    store(regenerate_tree_keystone_a_collected, true)
    regenerate_tree_keystone()
}
!item_data_name(regenerate_tree_keystone_a(), "Regenerate Tree Keystone")

!export(regenerate_tree_keystone_b)
fun regenerate_tree_keystone_b() {
    store(regenerate_tree_keystone_b_collected, true)
    regenerate_tree_keystone()
}
!item_data_name(regenerate_tree_keystone_b(), "Regenerate Tree Keystone")

fun regenerate_tree_keystone() {
    store(regenerate_tree_keystones, regenerate_tree_keystones + 1)
    if current_door_area == regenerate_tree store(player.keystones, player.keystones + 1)
    keysanity_keystone("Regenerate Tree Keystone", regenerate_tree_keystones, total_regenerate_tree_keystones)
}

