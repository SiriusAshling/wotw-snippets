fun regenerate_tree_progress() {
    two_keystone_hint(
        regenerate_tree_hint,
        regenerate_tree_keystone_a_collected, regenerate_tree_keystone_a_area,
        regenerate_tree_keystone_b_collected, regenerate_tree_keystone_b_area
    )
    keystone_progress("Regenerate Tree: ", regenerate_tree, regenerate_tree_keystones, total_regenerate_tree_keystones)
}

