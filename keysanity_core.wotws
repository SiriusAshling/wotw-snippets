on change depths_entrance_hint update_keystone_progress()
on change firefly_room_hint update_keystone_progress()
on change pools_hint update_keystone_progress()
on change wastes_hint update_keystone_progress()
on change burrows_hint update_keystone_progress()
fun update_keystone_progress() {
    write_keystone_progress()
    set_message_text("keystone_progress", get_string("column"))
}

fun write_keystone_progress() {
    new_column("")
    regenerate_tree_progress()
    add_row(get_string("row"))
    eyestones_progress()
    add_row(get_string("row"))
    den_progress()
    add_row(get_string("row"))
    woods_entrance_progress()
    add_row(get_string("row"))
    ku_section_progress()
    add_row(get_string("row"))
    reach_trial_progress()
    add_row(get_string("row"))
    grenade_tree_progress()
    add_row(get_string("row"))
    depths_entrance_progress()
    add_row(get_string("row"))
    firefly_room_progress()
    add_row(get_string("row"))
    pools_progress()
    add_row(get_string("row"))
    wastes_progress()
    add_row(get_string("row"))
    burrows_progress()
    add_row(get_string("row"))
}
