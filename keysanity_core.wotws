on change firefly_room_keystones update_keystone_progress()
on change pools_keystones update_keystone_progress()
on change wastes_keystones update_keystone_progress()
on change burrows_keystones update_keystone_progress()
on change regenerate_tree_hint update_keystone_progress()
on change eyestones_hint update_keystone_progress()
on change den_hint update_keystone_progress()
