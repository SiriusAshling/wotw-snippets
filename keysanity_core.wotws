on reload {
    set_wheel_item_data(
        "progress_helper",
        BottomLeft,
        "Keystone Progress",
        "[Ability1]View Progress",
        keystone_icon,
    )
    set_wheel_item_all_actions("progress_helper", BottomLeft, {
        write_keystone_progress()
        controlled_priority_message("keystone_progress", get_string("column"), 4)
    })
}

on change regenerate_tree_keystones update_keystone_progress()
on change eyestones update_keystone_progress()
on change den_keystones update_keystone_progress()
on change woods_entrance_keystones update_keystone_progress()
on change ku_section_keystones update_keystone_progress()
on change reach_trial_keystones update_keystone_progress()
