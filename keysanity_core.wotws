on Marsh.Howl.KeystoneDoor if regenerate_tree_keystones >= total_regenerate_tree_keystones store(regenerate_tree_keystones, regenerate_tree_keystones - total_regenerate_tree_keystones)
on Marsh.EyestoneDoor if eyestones >= total_eyestones store(eyestones, eyestones - total_eyestones)
on Marsh.Den.KeystoneDoor if den_keystones >= total_den_keystones store(den_keystones, den_keystones - total_den_keystones)
on Woods.FirstKeystoneDoor if woods_entrance_keystones >= total_woods_entrance_keystones store(woods_entrance_keystones, woods_entrance_keystones - total_woods_entrance_keystones)
on Woods.KuKeystoneDoor if ku_section_keystones >= total_ku_section_keystones store(ku_section_keystones, ku_section_keystones - total_ku_section_keystones)
on Reach.Trial.KeystoneDoor if reach_trial_keystones >= total_reach_trial_keystones store(reach_trial_keystones, reach_trial_keystones - total_reach_trial_keystones)
on Reach.TopKeystoneDoor if grenade_tree_keystones >= total_grenade_tree_keystones store(grenade_tree_keystones, grenade_tree_keystones - total_grenade_tree_keystones)
on Depths.FirstKeystoneDoor if depths_entrance_keystones >= total_depths_entrance_keystones store(depths_entrance_keystones, depths_entrance_keystones - total_depths_entrance_keystones)
on Depths.SecondKeystoneDoor if firefly_room_keystones >= total_firefly_room_keystones store(firefly_room_keystones, firefly_room_keystones - total_firefly_room_keystones)
on Pools.KeystoneDoor if pools_keystones >= total_pools_keystones store(pools_keystones, pools_keystones - total_pools_keystones)
on Wastes.KeystoneDoor if wastes_keystones >= total_wastes_keystones store(wastes_keystones, wastes_keystones - total_wastes_keystones)
on Burrows.KeystoneDoor if burrows_keystones >= total_burrows_keystones store(burrows_keystones, burrows_keystones - total_burrows_keystones)

!only_simulation {
    on regenerate_tree_keystones == total_regenerate_tree_keystones store(Marsh.Howl.KeystoneDoor, true)
    on eyestones == total_eyestones store(Marsh.EyestoneDoor, true)
    on den_keystones == total_den_keystones store(Marsh.Den.KeystoneDoor, true)
    on woods_entrance_keystones == total_woods_entrance_keystones store(Woods.FirstKeystoneDoor, true)
    on ku_section_keystones == total_ku_section_keystones store(Woods.KuKeystoneDoor, true)
    on reach_trial_keystones == total_reach_trial_keystones store(Reach.Trial.KeystoneDoor, true)
    on grenade_tree_keystones == total_grenade_tree_keystones store(Reach.TopKeystoneDoor, true)
    on depths_entrance_keystones == total_depths_entrance_keystones store(Depths.FirstKeystoneDoor, true)
    on firefly_room_keystones == total_firefly_room_keystones store(Depths.SecondKeystoneDoor, true)
    on pools_keystones == total_pools_keystones store(Pools.KeystoneDoor, true)
    on wastes_keystones == total_wastes_keystones store(Wastes.KeystoneDoor, true)
    on burrows_keystones == total_burrows_keystones store(Burrows.KeystoneDoor, true)
}

