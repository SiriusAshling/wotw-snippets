fun keysanity_keystone(name: String, amount: Integer, total: Integer) {
    set_string("color", "")
    if amount == total set_string("color", "$")
    item_message(name + get_string("color") + " (" + amount + "/" + total + ")" + get_string("color"))
}

!state(inside_regenerate_tree_triggers, Integer)
!state(inside_eyestone_statue_triggers, Integer)
!state(inside_den_triggers, Integer)
!state(inside_grenade_tree_triggers, Integer)
!state(inside_firefly_room_triggers, Integer)
!state(inside_pools_triggers, Integer)
!state(inside_wastes_triggers, Integer)

on reload {
    position_trigger_rectangle("keysanity_regenerate_tree_a", -887, -4454, -575, -4355)
    position_trigger_enter_callback("keysanity_regenerate_tree_a", enter_regenerate_tree_area())
    position_trigger_leave_callback("keysanity_regenerate_tree_a", leave_regenerate_tree_area())
    position_trigger_rectangle("keysanity_regenerate_tree_b", -576, -4413, -442, -4375)
    position_trigger_enter_callback("keysanity_regenerate_tree_b", enter_regenerate_tree_area())
    position_trigger_leave_callback("keysanity_regenerate_tree_b", leave_regenerate_tree_area())

    position_trigger_rectangle("keysanity_eyestone_statue_a", -482, -4275, -404, -4180)
    position_trigger_enter_callback("keysanity_eyestone_statue_a", enter_eyestone_statue_area())
    position_trigger_leave_callback("keysanity_eyestone_statue_a", leave_eyestone_statue_area())
    position_trigger_rectangle("keysanity_eyestone_statue_b", -405, -4256, -380, -4180)
    position_trigger_enter_callback("keysanity_eyestone_statue_b", enter_eyestone_statue_area())
    position_trigger_leave_callback("keysanity_eyestone_statue_b", leave_eyestone_statue_area())
    position_trigger_rectangle("keysanity_eyestone_statue_c", -381, -4256, -295, -4190)
    position_trigger_enter_callback("keysanity_eyestone_statue_c", enter_eyestone_statue_area())
    position_trigger_leave_callback("keysanity_eyestone_statue_c", leave_eyestone_statue_area())
    position_trigger_rectangle("keysanity_eyestone_statue_d", -296, -4243, -246, -4205)
    position_trigger_enter_callback("keysanity_eyestone_statue_d", enter_eyestone_statue_area())
    position_trigger_leave_callback("keysanity_eyestone_statue_d", leave_eyestone_statue_area())

    position_trigger_rectangle("keysanity_den_a", -580, -4577, -407, -4428)
    position_trigger_enter_callback("keysanity_den_a", enter_den_area())
    position_trigger_leave_callback("keysanity_den_a", leave_den_area())
    position_trigger_rectangle("keysanity_den_b", -408, -4577, -231, -4424)
    position_trigger_enter_callback("keysanity_den_b", enter_den_area())
    position_trigger_leave_callback("keysanity_den_b", leave_den_area())

    set_integer("top", -4124)
    if entrances.teddyHutOutside == 26 && entrances.teddyHutInside == 25 set_integer("top", -4105)
    position_trigger_rectangle("keysanity_woods_entrance", 391, -4215, 781, get_integer("top"))
    position_trigger_enter_callback("keysanity_woods_entrance", enter_woods_entrance_area())
    position_trigger_leave_callback("keysanity_woods_entrance", leave_woods_entrance_area())

    position_trigger_rectangle("keysanity_ku_section", 856, -4229, 1072, -4102)
    position_trigger_enter_callback("keysanity_ku_section", enter_ku_section_area())
    position_trigger_leave_callback("keysanity_ku_section", leave_ku_section_area())

    position_trigger_rectangle("keysanity_reach_trial", -103, -4065, 110, -4015)
    position_trigger_enter_callback("keysanity_reach_trial", enter_reach_trial_area())
    position_trigger_leave_callback("keysanity_reach_trial", leave_reach_trial_area())

    position_trigger_rectangle("keysanity_grenade_tree_a", -288, -3931, -178, -3839)
    position_trigger_enter_callback("keysanity_grenade_tree_a", enter_grenade_tree_area())
    position_trigger_leave_callback("keysanity_grenade_tree_a", leave_grenade_tree_area())
    set_integer("top", -3875)
    if entrances.reachSeedOutside == 24 && entrances.reachSeedInside == 23 set_integer("top", -3840)
    position_trigger_rectangle("keysanity_grenade_tree_b", -179, -3939, -17, get_integer("top"))
    position_trigger_enter_callback("keysanity_grenade_tree_b", enter_grenade_tree_area())
    position_trigger_leave_callback("keysanity_grenade_tree_b", leave_grenade_tree_area())

    position_trigger_rectangle("keysanity_depths_entrance", 105, -4483, 398, -4359)
    position_trigger_enter_callback("keysanity_depths_entrance", enter_depths_entrance_area())
    position_trigger_leave_callback("keysanity_depths_entrance", leave_depths_entrance_area())

    position_trigger_rectangle("keysanity_firefly_room_a", 401, -4486, 476, -4411)
    position_trigger_enter_callback("keysanity_firefly_room_a", enter_firefly_room_area())
    position_trigger_leave_callback("keysanity_firefly_room_a", leave_firefly_room_area())
    position_trigger_rectangle("keysanity_firefly_room_b", 475, -4486, 533, -4444)
    position_trigger_enter_callback("keysanity_firefly_room_b", enter_firefly_room_area())
    position_trigger_leave_callback("keysanity_firefly_room_b", leave_firefly_room_area())
    position_trigger_rectangle("keysanity_firefly_room_c", 532, -4486, 543, -4447)
    position_trigger_enter_callback("keysanity_firefly_room_c", enter_firefly_room_area())
    position_trigger_leave_callback("keysanity_firefly_room_c", leave_firefly_room_area())

    position_trigger_rectangle("keysanity_pools_a", -1588, -4154, -1532, -4085)
    position_trigger_enter_callback("keysanity_pools_a", enter_pools_area())
    position_trigger_leave_callback("keysanity_pools_a", leave_pools_area())
    position_trigger_rectangle("keysanity_pools_b", -1654, -4086, -1532, -3967)
    position_trigger_enter_callback("keysanity_pools_b", enter_pools_area())
    position_trigger_leave_callback("keysanity_pools_b", leave_pools_area())
    position_trigger_rectangle("keysanity_pools_c", -1533, -4101, -1472, -4024)
    position_trigger_enter_callback("keysanity_pools_c", enter_pools_area())
    position_trigger_leave_callback("keysanity_pools_c", leave_pools_area())
    position_trigger_rectangle("keysanity_pools_d", -1473, -4112, -1395, -4030)
    position_trigger_enter_callback("keysanity_pools_d", enter_pools_area())
    position_trigger_leave_callback("keysanity_pools_d", leave_pools_area())

    position_trigger_rectangle("keysanity_wastes_a", 1749, -3854, 1927, -3757)
    position_trigger_enter_callback("keysanity_wastes_a", enter_wastes_area())
    position_trigger_leave_callback("keysanity_wastes_a", leave_wastes_area())
    position_trigger_rectangle("keysanity_wastes_b", 1926, -3854, 2072, -3769)
    position_trigger_enter_callback("keysanity_wastes_b", enter_wastes_area())
    position_trigger_leave_callback("keysanity_wastes_b", leave_wastes_area())
}

on player_area() == Burrows enter_burrows_area()
on player_area() != Burrows leave_burrows_area()

fun enter_regenerate_tree_area() {
    store(inside_regenerate_tree_triggers, inside_regenerate_tree_triggers + 1)
    if inside_regenerate_tree_triggers == 1 {
        store(current_door_area, regenerate_tree)
        store(player.keystones, player.keystones + regenerate_tree_keystones)
    }
}
fun leave_regenerate_tree_area() {
    store(inside_regenerate_tree_triggers, inside_regenerate_tree_triggers - 1)
    if inside_regenerate_tree_triggers == 0 {
        if current_door_area == regenerate_tree store(current_door_area, 0)
        store(player.keystones, player.keystones - regenerate_tree_keystones)
    }
}

fun enter_eyestone_statue_area() {
