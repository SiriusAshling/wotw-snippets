fun two_keystone_hint(hint: Boolean, a: Boolean, a_area: String, b: Boolean, b_area: String) {
    if hint {
        new_row(" - ")
        if a == false add_row_item(a_area)
        if b == false add_row_item(b_area)
    }
    if hint == false || get_boolean("comma") == false set_string("row", "")
}

fun four_keystone_hint(
    hint: Boolean,
    a: Boolean, a_area: String,
    b: Boolean, b_area: String,
    c: Boolean, c_area: String,
    d: Boolean, d_area: String,
) {
    if hint {
        new_row(" - ")
        if a == false add_row_item(a_area)
        if b == false add_row_item(b_area)
        if c == false add_row_item(c_area)
        if d == false add_row_item(d_area)
    }
    if hint == false || get_boolean("comma") == false set_string("row", "")
}

fun keystone_progress(name: String, door_area: Integer, current: Integer, total: Integer) {
    set_string("color", "")
    if current_door_area == door_area set_string("color", "#")
    if current >= total set_string("color", "$")
    set_string("row", get_string("color") + name + current + "/" + total + get_string("color") + get_string("row"))
}

on reload {
    position_trigger_circle("regenerate_tree_door", regenerate_tree_door_x, regenerate_tree_door_y, door_radius)
    position_trigger_enter_callback("regenerate_tree_door", store(regenerate_tree_hint, true))

    position_trigger_rectangle("eyestone_door_left", eyestone_door_left_x, eyestone_door_left_y, eyestone_door_left_x + eyestone_door_left_width, eyestone_door_left_y + eyestone_door_left_height)
    position_trigger_enter_callback("eyestone_door_left", store(eyestones_hint, true))
    position_trigger_rectangle("eyestone_door_right", eyestone_door_right_x, eyestone_door_right_y, eyestone_door_right_x + eyestone_door_right_width, eyestone_door_right_y + eyestone_door_right_height)
    position_trigger_enter_callback("eyestone_door_right", store(eyestones_hint, true))

    position_trigger_circle("den_door", den_door_x, den_door_y, door_radius)
    position_trigger_enter_callback("den_door", store(den_hint, true))

    position_trigger_circle("woods_entrance_door", woods_entrance_door_x, woods_entrance_door_y, door_radius)
    position_trigger_enter_callback("woods_entrance_door", store(woods_entrance_hint, true))

    position_trigger_circle("ku_section_door", ku_section_door_x, ku_section_door_y, door_radius)
    position_trigger_enter_callback("ku_section_door", store(ku_section_hint, true))

    position_trigger_circle("reach_trial_door", reach_trial_door_x, reach_trial_door_y, door_radius)
    position_trigger_enter_callback("reach_trial_door", store(reach_trial_hint, true))

    position_trigger_circle("grenade_tree_door", grenade_tree_door_x, grenade_tree_door_y, door_radius)
    position_trigger_enter_callback("grenade_tree_door", store(grenade_tree_hint, true))

    position_trigger_circle("depths_entrance_door", depths_entrance_door_x, depths_entrance_door_y, door_radius)
    position_trigger_enter_callback("depths_entrance_door", store(depths_entrance_hint, true))

    position_trigger_circle("firefly_room_door", firefly_room_door_x, firefly_room_door_y, door_radius)
    position_trigger_enter_callback("firefly_room_door", store(firefly_room_hint, true))

    position_trigger_circle("pools_door", pools_door_x, pools_door_y, door_radius)
    position_trigger_enter_callback("pools_door", store(pools_hint, true))

    position_trigger_circle("wastes_door", wastes_door_x, wastes_door_y, door_radius)
    position_trigger_enter_callback("wastes_door", store(wastes_hint, true))

    position_trigger_circle("burrows_door", burrows_door_x, burrows_door_y, door_radius)
    position_trigger_enter_callback("burrows_door", store(burrows_hint, true))
}

on regenerate_tree_hint {
    regenerate_tree_progress()
    free_message("keysanity_regenerate_tree", get_string("row"))
    set_message_coordinate_system("keysanity_regenerate_tree", World)
    set_message_vertical_anchor("keysanity_regenerate_tree", Middle)
    set_message_position("keysanity_regenerate_tree", regenerate_tree_door_x, regenerate_tree_door_y)
    position_trigger_destroy("regenerate_tree_door")
}
on change regenerate_tree_keystones {
    regenerate_tree_progress()
    set_message_text("keysanity_regenerate_tree", get_string("row"))
}

on eyestones_hint {
    eyestones_progress()
    free_message("keysanity_eyestones_left", get_string("row"))
    set_message_coordinate_system("keysanity_eyestones_left", World)
    set_message_vertical_anchor("keysanity_eyestones_left", Middle)
    set_message_position("keysanity_eyestones_left", eyestone_door_left_x + eyestone_door_left_width / 2, eyestone_door_left_y + eyestone_door_left_height / 2)
    free_message("keysanity_eyestones_right", get_string("row"))
    set_message_coordinate_system("keysanity_eyestones_right", World)
    set_message_vertical_anchor("keysanity_eyestones_right", Middle)
    set_message_position("keysanity_eyestones_right", eyestone_door_right_x + eyestone_door_right_width / 2, eyestone_door_right_y + eyestone_door_right_height / 2)
    position_trigger_destroy("eyestone_door_left")
    position_trigger_destroy("eyestone_door_right")
}
on change eyestones {
    eyestones_progress()
    set_message_text("keysanity_eyestones_left", get_string("row"))
    set_message_text("keysanity_eyestones_right", get_string("row"))
}

on den_hint {
    den_progress()
