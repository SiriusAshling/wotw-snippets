#hidden
#name("Keysanity Core")
#description("Adds support for keystones that only fit into their designated doors")

// For your convenience, this is an include for all the keystones:
// !include(
//     "keysanity_core",
//     regenerate_tree_keystone_a,
//     regenerate_tree_keystone_b,
//     eyestone_a,
//     eyestone_b,
//     den_keystone_a,
//     den_keystone_b,
//     woods_entrance_keystone_a,
