#category("World Changes")
#name("No Wellspring")
#description("Just in case you really hate Wellspring")

!tags("No Wellspring")

on spawn store(Wellspring.OutsideRight.Ore, true)
on spawn store(Wellspring.OutsideRight.EF, true)
on spawn store(Wellspring.TrialStart.CeilingSL, true)
on spawn store(Wellspring.TrialStart.Ore, true)
on spawn store(raceGroup.wellspringRace, 2)
on spawn store(Wellspring.OutsideTopDoor.Shard, true)
on spawn store(Wellspring.OutsideLeftDoor.LF, true)
on spawn store(Wellspring.OutsideBottomDoor.CeilingSL, true)
on spawn store(Wellspring.Foundation.WheelSL, true)
on spawn store(Wellspring.Foundation.EF, true)
on spawn store(Wellspring.OutsideLeft.Shard, true)
on spawn store(Wellspring.Outside.SwimSL, true)
on spawn store(Wellspring.Outside.SwimOre, true)
on spawn store(questUberStateGroup.lostCompassQuest, 3)
on spawn store(Wellspring.FirstFloor.Shard, true)
on spawn store(Wellspring.FirstFloor.ShardSL, true)
on spawn store(Wellspring.FirstFloor.ThreeWheelsSL, true)
on spawn store(Wellspring.FirstFloor.WaterDashSL, true)
on spawn store(Wellspring.DrainSecret.LF, true)
on spawn store(Wellspring.DrainSecret.SL, true)
on spawn store(Wellspring.DrainClimb.PullPoleOre, true)
on spawn store(Wellspring.DrainClimb.LeverEF, true)
on spawn store(Wellspring.DrainClimb.LeverLeftSL, true)
on spawn store(Wellspring.LupoMap, true)
on spawn store(Wellspring.FirstFloor.ShortcutSL, true)
on spawn store(Wellspring.GrappleTree.SL, true)
on spawn store(Wellspring.GrappleTree, true)
on spawn store(Wellspring.SecondFloor.EntranceLeftSL, true)
!no_random_placement(Wellspring.HandToHand.Herbs)
on questUberStateGroup.tradeSequenceQuest == 2 store(questUberStateGroup.tradeSequenceQuest, 3)
on spawn store(Wellspring.RotatingRoom.SL, true)
on spawn store(Wellspring.RotatingRoom.Ore, true)
on spawn store(Wellspring.LostCompass.Needle, true)
on spawn store(Wellspring.ThirdFloor.EntranceSL, true)
on spawn store(Wellspring.ThirdFloor.TPSL, true)
on spawn store(Wellspring.Seed, true)
on spawn store(Wellspring.ThirdFloor.SwimOre, true)
on spawn store(Wellspring.Escape.RevisitSL, true)
on spawn store(Wellspring.Escape.Reward, true)
on Hollow.SilentTeeth.Started if kwolokGroupDescriptor.cleanseWellspringQuestUberState < 3 store(kwolokGroupDescriptor.cleanseWellspringQuestUberState, 3)
